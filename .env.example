# SQLite for local development. For PostgreSQL see README ("Switching to PostgreSQL").
DATABASE_URL="file:./dev.db"
# Used to sign nothing secret client-side; sessions are random tokens stored hashed in the DB.
SESSION_COOKIE_NAME="ss_session"
# Set to "true" behind HTTPS so cookies are Secure.
COOKIE_SECURE="false"
# Upload storage: "local" (public/uploads) in development. "s3" is not configured yet.
UPLOAD_DRIVER="local"
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# Not configured integrations (leave empty; the UI shows "Not configured"):
# PAYMENT_PROVIDER_KEY=""
# SMS_PROVIDER_KEY=""
# EMAIL_PROVIDER_KEY=""
# COURIER_API_KEY=""
